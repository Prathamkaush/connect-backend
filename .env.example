NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://masters:masters@localhost:5434/masters?schema=public
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Active AI provider: gemini for testing, openai when the production key is ready.
AI_PROVIDER=openrouter
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_PUBLIC_URL=
FREE_QUESTION_LIMIT=5
CHAT_RATE_LIMIT_USER=10
CHAT_RATE_LIMIT_IP=30
CHAT_RATE_WINDOW_SECONDS=60
CONTEXT_RECENT_MESSAGES=14
CONTEXT_SUMMARY_THRESHOLD=24
MASTER_CACHE_TTL_SECONDS=900
REQUEST_LOCK_TTL_SECONDS=90
SEED_ADMIN_EMAIL=admin@connect2infinity.ai
SEED_ADMIN_PASSWORD=

# OpenRouter free-model testing (set AI_PROVIDER=openrouter after adding your key)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
